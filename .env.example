POLAR_CLIENT_ID=
POLAR_CLIENT_SECRET=
POLAR_REDIRECT_URI=http://localhost:5000/oauth2_callback
FLASK_SECRET_KEY=
POLAR_TOKEN_ENCRYPTION_KEY=
MOBILE_SYNC_API_TOKEN=
# Account session signing key for iOS. Generate with `python -c 'import secrets; print(secrets.token_urlsafe(48))'`.
RHYTHMOS_MOBILE_SESSION_SIGNING_KEY=
# Native iOS bundle identifier used as the Apple identity-token audience.
RHYTHMOS_APPLE_AUDIENCE=com.rhythmos.ios
# Closed-beta account allowlist. Prefer the SHA-256 fingerprint supplied by a
# verified first Apple sign-in; never put an Apple email address here.
RHYTHMOS_OWNER_APPLE_SUB_SHA256=
# Enables the owner's RHYTHMOS account-name/password registration during a
# closed test. Keep false except for the one-time invited registration.
RHYTHMOS_ACCOUNT_REGISTRATION_ENABLED=false
# SHA-256 of the one-time closed-test invitation code. The raw code is entered
# only while the owner creates the first RHYTHMOS account and is never stored.
RHYTHMOS_ACCOUNT_REGISTRATION_CODE_SHA256=
POLAR_CONNECT_PASSWORD=
# Optional: enables local macOS projection publishing after its normal sync.
RHYTHMOS_SYNC_SERVICE_URL=
